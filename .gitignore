# OS / editor
.DS_Store
.vscode/
.idea/
# Obsidian per-user workspace state (keep the notes, not your UI layout)
obsidian/.obsidian/workspace*.json
obsidian/.obsidian/cache

# Python
__pycache__/
*.pyc
.venv/
venv/

# Large data and models: downloaded by slurm/prepare_assets.sh, never commit them
data/
ckpt/
cache/
*.npy
*.pt
*.pth
*.tar
*.tar.gz
*.zip

# Generated by analysis/make_report.py and scripts/render_pdf.py (re-creatable)
analysis/assets/
analysis/official-tent-report.*
analysis/report-status.json
analysis/pdf-quality.json

# Matplotlib font cache that a job may leave behind
plot-cache/
.mpl/
